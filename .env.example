# Optional: verified GA4 property. Empty keeps analytics disabled.
# Disable Enhanced Measurement history pageviews when using manual SPA views.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only Netlify function configuration. Never use NEXT_PUBLIC_ prefixes.
# Set these in Netlify's function environment; do not commit real values.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional comma-separated HTTPS preview origins allowed to submit inquiries.
# Configure only explicit approved origins and use a sandbox CRM for testing.
LEAD_ALLOWED_ORIGINS=
