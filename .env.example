# Optional: verified GA4 property. Empty keeps analytics disabled.
# Disable Enhanced Measurement history pageviews when using manual SPA views.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: native Google Ads accepted-quote conversion. Use the actual account's
# conversion ID (AW-...) and label; both are public identifiers, not API secrets.
# Leave blank until the conversion action and its campaign goal are verified.
# This must be the only primary measurement of a submitted quote; do not also
# import GA4 generate_lead as a second primary conversion for the same lead.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Optional actual calls-from-website actions, separate from quote submission and
# calls from ads. Used only on each matching /quote/ route; never on phone clicks.
NEXT_PUBLIC_GOOGLE_ADS_WEBSITE_CALL_LABEL_SACRAMENTO=
NEXT_PUBLIC_GOOGLE_ADS_WEBSITE_CALL_LABEL_WALNUT_CREEK=

# Optional Ads base loader: the verified GTM-MB764DLF container is tied to
# AW-11465582021. Measurement uses US regional defaults with restricted data
# processing; saved opt-outs and Global Privacy Control block Ads. Our own click
# and campaign storage still requires explicit opt-in. Empty uses the direct
# Google tag. Keep lead conversions in the site's accepted-receipt handler;
# adding a conversion tag or GA4 tag to this container requires coordination.
NEXT_PUBLIC_GTM_ID=

# Server-only Netlify function configuration. Never use NEXT_PUBLIC_ prefixes.
# Set these in Netlify's function environment; do not commit real values.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional comma-separated HTTPS preview origins allowed to submit inquiries.
# Configure only explicit approved origins and use a sandbox CRM for testing.
LEAD_ALLOWED_ORIGINS=
